includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - ecs.php
        - rector.php
    # ECS bundles PHP-CS-Fixer (and its `PhpCsFixer\` namespace) instead of
    # installing it as a direct dependency, so teach PHPStan where to find it.
    scanDirectories:
        - vendor/symplify/easy-coding-standard/vendor/friendsofphp/php-cs-fixer/src
    tmpDir: .build/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # PHPUnit assertion methods are static; the idiomatic `$this->assertX()`
        # call is a deliberate dynamic call and is not a problem in tests.
        -
            identifier: staticMethod.dynamicCall
            paths:
                - tests
