{
    "name": "ancient-web/phpunit-test-time",
    "description": "PHPUnit extension that measures per-test execution time and writes a report sorted by duration",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "phpunit",
        "extension",
        "testing",
        "performance",
        "paratest"
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AncientWeb\\PhpUnitTestTime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AncientWeb\\PhpUnitTestTime\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "stan:baseline": "phpstan analyse --configuration=phpstan.neon --memory-limit=-1 --allow-empty-baseline --generate-baseline=phpstan-baseline.neon",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.php --diff",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "rector": "rector process --config=rector.php",
        "rector:check": "rector process --config=rector.php --dry-run",
        "it": [
            "@cs:check",
            "@stan",
            "@rector:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
